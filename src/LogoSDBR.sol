pragma solidity ^0.8.26;

import { Base64 } from "@openzeppelin/contracts/utils/Base64.sol";

/// @title LogoSDBR — a logo oficial do SDBR gravada na blockchain
/// @notice Guarda o SVG oficial da logo, byte a byte igual ao arquivo no IPFS, para sempre.
/// Sem dono e sem nenhuma função de escrita: ninguém consegue trocar a logo.
/// O mesmo contrato está no mesmo endereço nas 7 redes do SDBR.
contract LogoSDBR {
    /// @notice O token SDBR (mesmo endereço em BNB Smart Chain, Base, Arbitrum, Polygon,
    /// Optimism, Avalanche e Celo).
    address public constant TOKEN = 0x00000000001C77283FDB79c1D012930C3c987cbc;

    string public constant NOME = "Solidity Brasil (SDBR)";

    /// @notice Mesmas imagens no IPFS (CID = hash do arquivo; não muda de conteúdo).
    string public constant IPFS_SVG = "ipfs://bafkreigxha7p5pobhziodcmggazhoxbsfrfl4iylvh55cqu4wymozomgiy";
    string public constant IPFS_PNG_512 = "ipfs://bafkreidofraq2qqejjsvys3urhb2dr6ngikk2zzhzkjsffdrfjob2s7tbe";

    bytes internal constant SVG = hex"";

    /// @notice O SVG da logo.
    function svg() public pure returns (string memory) {
        return string(SVG);
    }

    /// @notice keccak256 do SVG — confere com o arquivo em qualquer lugar (site, IPFS).
    function hashSvg() external pure returns (bytes32) {
        return keccak256(SVG);
    }

    /// @notice A logo pronta para exibir (data URI), como `image` de metadados.
    function imagem() external pure returns (string memory) {
        return string.concat("data:image/svg+xml;base64,", Base64.encode(SVG));
    }
}
